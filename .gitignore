# Raw logs, recorded audio, and anything containing a real voice stay local
# (CLAUDE.md §1). The directory itself is kept so paths in configs resolve.
results/raw/*
!results/raw/.gitkeep

# The data deposit (src/scripts/release_bundle.py): built at submission, uploaded,
# never committed.
/dist/

# Model weights and audio are never committed
*.gguf
*.onnx
*.pt
*.ckpt
*.safetensors
*.wav
*.flac
*.mp3
*.ogg
*.opus

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# LaTeX build files (sources are committed; artifacts are rebuilt by make)
paper/*.pdf
thesis/*.pdf
presentation/*.pdf
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
paper/*.log
thesis/*.log
presentation/*.log

# Secrets. The Overleaf git token lives OUTSIDE this repository, in
# ~/.config/overleaf/credentials (mode 600), read by a git credential helper in
# ~/.gitconfig; git cannot see it from here. These patterns stop a copy of it, or
# of any other credential, from being added by accident. The secret-scan hooks
# (pre-commit, pre-merge-commit, pre-push; `make hooks`, once per clone) and
# `make check` run src/scripts/secret_scan.py, which refuses token-shaped
# strings and these names even when force-added.
credentials
*credentials.*
.git-credentials
.env
.env.*
.netrc
*.token
*.pem
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
.overleaf/
